#!/usr/bin/env node

import { execFileSync } from "node:child_process";
import * as p from "@clack/prompts";

function listBranches() {
  const output = execFileSync(
    "git",
    [
      "for-each-ref",
      "--format=%(refname:short)%09%(upstream:short)%09%(upstream:track)",
      "refs/heads/",
    ],
    { encoding: "utf8" },
  );

  return output
    .split("\n")
    .filter(Boolean)
    .map((line) => {
      const [name, upstream, track] = line.split("\t");
      return { name, status: upstreamStatus(upstream, track) };
    });
}

function upstreamStatus(upstream, track) {
  if (!upstream) return "?";
  if (track === "[gone]") return "✗";
  return "✓";
}

function label(branch) {
  return `[${branch.status}] ${branch.name}`;
}

function exitIfCancelled(value) {
  if (!p.isCancel(value)) return;
  p.cancel("Cancelled");
  process.exit(1);
}

const branches = listBranches();

if (process.argv[2] !== "--clean") {
  for (const branch of branches) console.log(label(branch));
  process.exit(0);
}

const toDelete = await p.multiselect({
  message: "Choose branches to delete:",
  options: branches.map((branch) => ({
    value: branch.name,
    label: label(branch),
  })),
  required: false,
});
exitIfCancelled(toDelete);

if (toDelete.length === 0) {
  p.outro("Nothing to delete");
  process.exit(0);
}

const confirmed = await p.confirm({
  message: `Delete the following branches? ${toDelete.join(" ")}`,
  initialValue: false,
});
exitIfCancelled(confirmed);

if (!confirmed) {
  p.outro("ok");
  process.exit(0);
}

execFileSync("git", ["branch", "-D", ...toDelete], { stdio: "inherit" });
