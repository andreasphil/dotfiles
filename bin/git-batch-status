#!/usr/bin/env node

import { execFileSync } from "node:child_process";
import { readdirSync } from "node:fs";
import * as p from "@clack/prompts";

const ui = { output: process.stderr };

function git(cwd, ...args) {
  return execFileSync("git", ["-C", cwd, ...args], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "ignore"],
  }).trim();
}

function gitSucceeds(cwd, ...args) {
  try {
    git(cwd, ...args);
    return true;
  } catch {
    return false;
  }
}

function countLines(text) {
  return text ? text.split("\n").length : 0;
}

function flag(isSet, detail = "") {
  return isSet ? `❗ yes${detail}` : "✅ no";
}

function repoStatus(dir) {
  const branch = git(dir, "branch", "--show-current");
  const branchCount = countLines(git(dir, "branch"));
  const hasChanges =
    !gitSucceeds(dir, "diff", "--quiet") ||
    !gitSucceeds(dir, "diff", "--cached", "--quiet");
  const stashCount = countLines(git(dir, "stash", "list"));
  const unpublished = Number(
    git(dir, "rev-list", "--count", "--branches", "--not", "--remotes"),
  );

  return [
    `${dir}/`,
    `${branch} (${branchCount})`,
    flag(hasChanges),
    flag(stashCount > 0),
    flag(unpublished > 0, ` (${unpublished})`),
  ];
}

function alignColumns(rows) {
  const widths = rows[0].map((_, i) =>
    Math.max(...rows.map((row) => row[i].length)),
  );
  return rows.map((row) =>
    row.map((cell, i) => cell.padEnd(widths[i])).join("  ").trimEnd(),
  );
}

if (gitSucceeds(".", "status")) {
  p.log.error("Current folder is a git repository", ui);
  process.exit(1);
}

const repos = readdirSync(".", { withFileTypes: true })
  .filter((entry) => entry.isDirectory())
  .map((entry) => entry.name)
  .filter((dir) => gitSucceeds(dir, "status"))
  .sort();

if (repos.length === 0) {
  p.log.warn("No repositories found", ui);
  process.exit(0);
}

const header = ["Name", "Branch", "Has changes", "Has stash", "Unpublished"];
const [headerLine, ...lines] = alignColumns([header, ...repos.map(repoStatus)]);

const selected = await p.select({
  ...ui,
  message: `  ${headerLine}`,
  options: lines.map((label, i) => ({ value: repos[i], label })),
  maxItems: 20,
});

if (p.isCancel(selected)) {
  p.cancel("Cancelled", ui);
  process.exit(1);
}

console.log(`${selected}/`);
